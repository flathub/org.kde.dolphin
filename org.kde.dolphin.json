                    "sha256": "e480794855c4cbfc629352dcf84e15561004cc73ac5b96246725695209f7e828",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8761,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/plasma/$version/kde-cli-tools-$version.tar.xz"
                    }
                }
            ]
        },
