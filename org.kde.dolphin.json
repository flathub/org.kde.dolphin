                    "sha256": "f2ef2df829b56365e864eecc8d5040d9b2583adb8fe673234f83f581d89089f1",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8761,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/plasma/$version/kde-cli-tools-$version.tar.xz"
                    }
                }
            ]
        },
